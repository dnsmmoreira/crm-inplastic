# ---------------------------------------------------------------------------
# CRM INPLASTIC — exemplo de variáveis de ambiente
# Copie para .env e preencha. NUNCA versione valores reais.
# No Lovable Cloud as chaves SUPABASE_* / VITE_SUPABASE_* são geradas
# automaticamente; as demais são cadastradas como Secrets do projeto.
# ---------------------------------------------------------------------------

# --- Backend (Supabase / Lovable Cloud) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- WhatsApp Cloud API (Meta) — único canal de envio/recebimento ---
META_GRAPH_VERSION=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_TEMPLATE_NAME=retomada_atendimento
META_TEMPLATE_LANG=pt_BR

# --- n8n (agente de IA / automações) ---
N8N_WEBHOOK_URL=
N8N_SECRET=

# --- Telegram (notificações internas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_DIRETORIA=
TELEGRAM_CHAT_FINANCEIRO=

# --- Destinatários internos de alerta (WhatsApp, só dígitos, com DDI 55) ---
WHATSAPP_DIRETORIA=
WHATSAPP_FINANCEIRO=

# --- Motor Xerife (hooks públicos protegidos por segredo) ---
XERIFE_SECRET=

# --- Google Maps (cálculo de distância/frete) ---
GOOGLE_MAPS_API_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# --- Consulta de CNPJ (CNPJá) ---
CNPJA_API_KEY=

# --- Lovable AI Gateway (usado em cálculos assistidos por IA) ---
LOVABLE_API_KEY=
